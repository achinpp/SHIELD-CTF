# Copy to `.env` (Docker) and `.env.local` (npm run dev), then fill in.
# Both are gitignored. Never commit real values.

# Postgres password. Generate a fresh one, do not reuse this placeholder:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
POSTGRES_PASSWORD=change-me

# How the app reaches Postgres.
#
#  - Docker (.env):     compose.yaml builds this itself from POSTGRES_PASSWORD
#                       and the `db` service name, so it is not needed here.
#  - Local (.env.local): point at a database you can reach from the host. The
#                        compose database publishes no port, so either run
#                        `docker compose up db` with a temporary `ports:` entry
#                        or use a separate local Postgres.
DATABASE_URL=postgres://shield:change-me@localhost:5432/shield

# Host port for the web container. Defaults to 3000.
# WEB_PORT=3001
