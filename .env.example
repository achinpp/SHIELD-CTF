# Copy this file before the app will start. Which copies you need depends on
# how you run it — see "Getting started" in the README.
#
#   All in Docker      ->  .env        (POSTGRES_PASSWORD only)
#   npm run dev        ->  .env  AND  .env.local
#
# Both are gitignored. Never commit real values.

# Postgres password. Generate a fresh one, do not reuse this placeholder:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
#
# It is read on the database's FIRST start and baked into the volume. Changing
# it later does not change the password Postgres already has — you would need
# `docker compose down -v` (which drops every account) or an ALTER ROLE.
POSTGRES_PASSWORD=change-me

# ── .env.local only ────────────────────────────────────────────────────────
# How `npm run dev` reaches Postgres, running on the host rather than in the
# compose network.
#
# In Docker this is not needed at all: compose.yaml builds it from
# POSTGRES_PASSWORD and the `db` service name.
#
# Note the port. `npm run db` publishes the database on 127.0.0.1:55432, not
# 5432, so it cannot collide with a Postgres already installed on the machine.
# The password here must match POSTGRES_PASSWORD above.
DATABASE_URL=postgres://shield:change-me@localhost:55432/shield

# Host port for the web container. Defaults to 3000.
# WEB_PORT=3001
